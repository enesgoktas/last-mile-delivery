# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
backend/.venv/
.coverage
coverage.xml
*.coverage*

# V&V tooling outputs (sensitivity sweeps, backtests, benchmark CSVs)
.v_and_v/
backend/tests/validation_and_verification/_results/

# Transient benchmark/profile dumps
backend/tmp/

# Cython build artifacts (generated from .pyx — do not commit)
*.c
*.so
*.pyd
build/
# Node / frontend
node_modules/
dist/
*.tsbuildinfo

# Environment / local config
.env
.env.*
!.env.example

# Local npm registry overrides (machine/company specific)
frontend/.npmrc
mobile/.npmrc

# Expo local machine state
mobile/.expo/

# Logs
*.log

# OSRM map data (large binary files, generated by scripts/prepare_osrm_data.sh)
backend/osrm_data/

# Celery beat schedule (runtime state, not source)
backend/celerybeat-schedule

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
