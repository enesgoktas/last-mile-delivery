# Last-Mile Delivery — Backend environment variables
# Copy this file to .env and fill in real values.
#
# For local development:
#   cp .env.example .env
#   docker compose up -d
#
# For production / staging: set these as environment variables in ECS task
# definition or Secrets Manager — never commit real secrets.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://delivery:delivery@localhost:5432/delivery_db

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (REQUIRED — app will refuse to start without a real secret) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
AUTH_JWT_ACTIVE_KID=auth-v1
# Optional JSON object of previous auth verification keys kept during rotation windows.
# Example: {"auth-v0":"old-secret-value"}
AUTH_JWT_PREVIOUS_KEYS={}
TRACKING_JWT_SECRET=
TRACKING_JWT_ACTIVE_KID=tracking-v1
# Optional JSON object of previous tracking verification keys kept during rotation windows.
TRACKING_JWT_PREVIOUS_KEYS={}
OIDC_SECRET_ENCRYPTION_KEY=
AUTH_SIGNUP_RATE_LIMIT_PER_MIN=3
PUBLIC_TRACKING_READ_RATE_LIMIT_PER_MIN=60
PUBLIC_TRACKING_WRITE_RATE_LIMIT_PER_HOUR=6
# Only enable when the app sits behind a trusted reverse proxy or CDN.
TRUST_PROXY_HEADERS=False
# Comma-separated list of trusted proxy CIDRs. Example: 10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXY_CIDRS=

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Routing — Self-hosted OSRM (local Docker services) ───────────────
# No API key required. See scripts/prepare_osrm_data.sh to set up map data.
#
# Two OSRM containers are required (built from the same Istanbul.osm.pbf):
#   osrm-car   — default car.lua profile  (cars, vans, motorcycles)
#   osrm-truck — custom truck.lua profile (HGVs; respects hgv=no, maxweight, maxheight, …)
#
# Run: bash scripts/prepare_osrm_data.sh   (builds both graphs)
#      docker compose up -d osrm-car osrm-truck
#
# OSRM_BASE_URL is the fallback used when a vehicle profile has no explicit entry
# in OSRM_PROFILE_BASE_URLS. Point it at the car server.
OSRM_BASE_URL=http://localhost:5001
# JSON mapping of profile name → base URL.  Keys must match values returned by
# vehicle_routing_profile.resolve_osrm_profile_from_values().
OSRM_PROFILE_BASE_URLS={"driving":"http://localhost:5001","motorcycle":"http://localhost:5001","truck":"http://localhost:5002"}
DISTANCE_MATRIX_CACHE_TTL=3600
DISTANCE_MATRIX_CACHE_VERSION=v2

# ── Geocoding ────────────────────────────────────────────────────────
PHOTON_BASE_URL=http://localhost:2322

# ── S3 / POD uploads ────────────────────────────────────────────────
S3_BUCKET=delivery-pod-files
AWS_REGION=us-east-1
# Set to False in production so POD uploads work for real
S3_PRESIGN_DRY_RUN=True

# ── CORS (comma-separated origins) ──────────────────────────────────
# Production example: https://dispatch.yourcompany.com,https://tracking.yourcompany.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Runtime metrics / CloudWatch EMF ────────────────────────────────
# Leave disabled locally unless you explicitly want raw EMF JSON lines on stdout.
EMF_METRICS_ENABLED=False
EMF_METRICS_NAMESPACE=LastMile/Application
EMF_METRICS_APPLICATION=last-mile-delivery
EMF_METRICS_SERVICE=api

# ── Notifications ────────────────────────────────────────────────────
# Set to False in production so emails and SMS actually send
NOTIFICATION_DRY_RUN=True
TRACKING_PUBLIC_BASE_URL=http://localhost:5174/tracking

# Email (Amazon SES)
SES_FROM_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (Firebase Cloud Messaging HTTP v1)
# FCM_PROJECT_ID: your Firebase project ID (visible in Firebase Console → Project Settings)
# FCM_SERVICE_ACCOUNT_JSON: the *entire* JSON content of your Firebase service account key,
#   stored as a single-line string.
#   Generate it at: Firebase Console → Project Settings → Service Accounts → Generate new private key.
#   In production, store this in AWS Secrets Manager or equivalent and inject via env.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── Webhooks ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, webhook secrets are stored in plaintext in the database.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# ── Superadmin ────────────────────────────────────────────────────────
# Platform-level API key for managing tenants. Keep secret.
# Required to use /api/v1/admin/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(40))"
SUPERADMIN_API_KEY=
